{
  "name": "vm-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated voice-agent testing: a realtime-model caller dials the Studio web-voice test target on staging",
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "typecheck": "tsc --noEmit",
    "targets": "npm run build:browser && tsx src/list-targets.ts",
    "call": "npm run build:browser && tsx src/run.ts",
    "ui": "tsx src/ui/server.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "jssip": "^3.10.1",
    "playwright": "1.59.1",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
