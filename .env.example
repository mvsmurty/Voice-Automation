# Copy to .env and fill in. Never commit .env.
PLATFORM_ORIGIN=https://de-agents.kore.ai
PROJECT_ID=01a0bfdf-18ad-7315-88d6-b286402a2f10
# Voice channel (connection) id whose Studio test-call target to dial. Run `npm run targets` to list.
CONNECTION_ID=
# Bearer token copied from the Studio UI (expires; refresh when calls return HTTP_401)
VM_BEARER_TOKEN=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Judge (phase 2) also uses GEMINI_API_KEY; set a text/multimodal model id here
GEMINI_JUDGE_MODEL=gemini-2.5-flash


